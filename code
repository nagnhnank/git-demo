       cout<<"\n___MENU___\n1.Nhap danh sach\n2.In danh sach\n3.Sap xep lai danh sach\n4.Tim kiem thong tin\n5.Bo sung thong tin\n6.Xoa thong tin\n0.Dung chuong trinh"<<endl;
       x=getch();
       switch (x) {
           case 98:
               cout<<"+++TEXT+++"<<endl;
               n.datatext();

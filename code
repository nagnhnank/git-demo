using namespace std;
class ho {//lớp ho với các thuộc tính đề bài yêu cầu
   public:
   string macanho;
   char toanha;
   int tang;
   double dientich;
   int sophongngu;
   int gia;
   string trangthai;
   ho() {//hàm tạo của lớp ho
       macanho="####";
       toanha = '#';
       tang=0;
       dientich=0.0;
       sophongngu=0;
       gia=0;
       trangthai="khong ro";
   }
   ho(const ho& h) {// hàm sao chép, const nhằm ngăn các giá trị của biến cần sao chép bị sửa đổi, "ho& h" tương tự "ho *h"
       macanho=h.macanho;
       toanha = h.toanha;
       tang= h.tang;
       dientich= h.dientich;
       sophongngu= h.sophongngu;
       gia= h.gia;
       trangthai=h.trangthai;
   }
   void nhap() {// phương thức nhập cho các đối tượng tạo từ lớp ho
       int x;
       cout<<"\n|ma can ho =<ten toa nha(1 chu cai)>+<so tang>+<so nha>(3->5 ki tu)|\n|VD:ten toa nha la A,ho nam tai tang thu 1, so nha 01 thi ma la A101 hoac A0101|\nNhap ma can ho:";
       do {
           cin>>macanho;
       }while (macanho.length()>5||macanho.length()<3);
       toanha=macanho[0];// tên tòa nhà là kí tự đầu
       if (macanho.length()<5) tang=macanho[1]-'0';//trường hợp số tầng dưới 10
       else tang=(macanho[1]-'0')*10+(macanho[2]-'0');// trường hợp số tầng từ 10 trở lên
       cout<<"Dien tich:";cin>>dientich;
       cout<<"So phong ngu:";cin>>sophongngu;
       cout<<"Gia:";cin>>gia;
       cout<<"Trang thai:\n1.Da ban\n2.Chua ban";
       do {
           cin>>x;
       }while (x!=1&&x!=2);
       if (x==1) trangthai="Da ban";
       else trangthai="Chua ban";
   }
   void in() {//phương thức in thông tin của 1 đối tượng
       printf("\n|ma can ho|toa nha|tang|dien tich|so phong ngu|%8s|trang thai|","gia");
       printf("\n|%9s|%7c|%4d|%9.2f|%12d|%8d|%10s|",macanho.c_str(),toanha,tang,dientich,sophongngu,gia,trangthai.c_str());
   }
};
class qlchungcu{//lớp quản lí chung cư gồm mảng đối tượng ds thuộc lớp ho
   int slho;//n
   ho ds[200];
   public:
   qlchungcu() {//hàm tạo của lớp qlchungcu
       slho=0;
       //trong hàm không cần gắn giá trị mặc định cho ds vì ds dùng class ho đã có hàm tạo sẵn
   }
   void datatext();//gán nhanh danh sách các hộ chung cư bằng bộ quy tắc có giá trị ngẫu nhiên


   void nhapchungcu();//các hàm chức năng đề bài yêu cầu
   void inchungcu();
   void sapxep();
   void timkiem();
   void them();
   void xoa();
};
void qlchungcu::nhapchungcu() {// hàm nhập danh sách các hộ trong chung cư
   cout<<"Nhap so luong ho:";cin>>slho;
   while (slho<1||slho>200) {//dùng while sau lần nhập đầu thay do-while để thông báo nhập lại chỉ hiện nếu lần đầu nhập sai
       cout<<"Nhap lai!\nso luong ho:";cin>>slho;
   }
   for (int i=0;i<slho;i++) {
       cout<<"Ho thu "<<i+1<<":";
       ds[i].nhap();
       if (i>0) {
           for (int j=0;j<i;j++) {
               while (ds[i].macanho==ds[j].macanho) {//chống lặp lại mã căn hộ
                   cout<<"Ma can ho da ton tai!\nNhap lai toan bo thong tin!"<<endl;
                   ds[i].nhap();
               }
           }
       }
   }
}
void qlchungcu::inchungcu() {//In bảng thông tin các hộ
   printf("\n|stt|ma can ho|toa nha|tang|dien tich|so phong ngu|%8s|trang thai|","gia");
   for (int i=0;i<slho;i++) {
       printf("\n|%3d|%9s|%7c|%4d|%9.2f|%12d|%8d|%10s|",i+1,ds[i].macanho.c_str(),ds[i].toanha,ds[i].tang,ds[i].dientich,ds[i].sophongngu,ds[i].gia,ds[i].trangthai.c_str());
   }
}
void qlchungcu::sapxep() {//sắp xếp nổi bọt(Bubble Sort)
   ho m;
   for (int i=0;i<slho-2;i++) {
       for (int j=0;j<slho-1;j++) {
           if (ds[j].dientich==ds[j+1].dientich) {
               m=ds[j];
               ds[j]=ds[j+1];
               ds[j+1]=m;
           }
       }
   }
}

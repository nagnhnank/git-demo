   cout<<"1.Tim theo ma\n2.Tim theo trang thai\n--nhap bat ki de thoat--"<<endl;
   int x=getch();//dùng hàm getch để lấy kí tự từ bàn phím mà không cần nhấn enter
   string a;
   switch (x) {
       case 49://tìm theo mã, do mã từng hộ là độc nhất nên ngay sau khi tìm thấy và in kết qủa thì return luôn
           cout<<"\nNhap ma ho can tim:";cin>>a;
           while (a.length()>4) {
               cout<<"qua dai, nhap lai!\nNhap ma ho can tim:";cin>>a;
           }
           for (int i=0;i<slho;i++) {
               if (a==ds[i].macanho) {
                   cout<<"Thong tin ho can tim:"<<endl;
                   ds[i].in();

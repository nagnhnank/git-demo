           break;
       case 50://tìm theo trạng thái, in tất cả kết quả theo trạng thái đã chọn
           int m,k=0;
           cout<<"\nChon trang thai cua cac can ho:\n1.Da ban\n2.Chua ban\n"<<endl;
           do{
               m=getch();
               if (m==49) a="Da ban";
               else if (m==50) a="Chua ban";
           }while (m!=49&&m!=50);
           cout<<"Danh sach cac ho ";
           if (a=="Da ban") cout<<"da ban la:"<<endl;
           else cout<<"chua ban la:"<<endl;
           printf("\n|stt|ma can ho|toa nha|tang|dien tich|so phong ngu|%8s|trang thai|","gia");
           for (int i=0;i<slho;i++) {
               if (ds[i].trangthai==a) {
                   k++;
                   printf("\n|%3d|%9s|%7c|%4d|%9.2f|%12d|%8d|%10s|",k,ds[i].macanho.c_str(),ds[i].toanha,ds[i].tang,ds[i].dientich,ds[i].sophongngu,ds[i].gia,ds[i].trangthai.c_str());
               }
           }
           break;
   }
   cout<<"Da ve menu!"<<endl;
}
void qlchungcu::them() {//hàm thêm 1 hộ
   if (slho==200) {//nếu số lượng hộ đã đạt tối đa(200) thì hàm ngắt ngay
       cout<<"\nDanh sach da day, khong the them!"<<endl;
       return;
   }
   int k;
   cout<<"Nhap vi tri muon them:";cin>>k;
   while (k<1||k>slho) {
       cout<<"Nhap lai!"<<endl;cin>>k;
   }
   k--;//vị trí cần thêm bằng số thứ tự -1(stt đếm từ 1 còn vị trí trong mảng đếm từ 0)
   for (int i=slho;i>k;i--) {//chạy từ cuối danh sách về k
       ds[i]=ds[i-1];//truyền dữ liệu tại vị trí i vào vị trí i+1 trong mảng
   }
   ds[k].nhap();// nhập dữ liệu tại vị trí k của mảng
   slho++;//sau khi thêm, số lượng hộ tăng 1
}
void qlchungcu::xoa() {//hàm xoa s 1 hộ
   int k;
   cout<<"Nhap vi tri muon xoa:";cin>>k;
   while (k<1||k>slho) {
       cout<<"Nhap lai!"<<endl;cin>>k;
   }
   k--;//tương tự, vị trí cần xóa bằng số thứ tự -1(stt đếm từ 1 còn vị trí trong mảng đếm từ 0)
   for (int i=k;i<slho-1;i++) {//chạy từ k đến cuối danh sách
       ds[i]=ds[i+1];//truyền dữ liệu tại vị trí i+1 vào vị trí i trong mảng
   }
   slho--;//sau khi xóa, số lượng hộ giảm 1
}
int snt(int x) {
   for (int i=1;i<x/2+1;i++) {
       if (x%i!=0) return 0;
   }
   return 1;
}
void qlchungcu::datatext() {//tạo đầu vào ngẫu nhiên
   random_device rd;
   mt19937_64 gen(rd());
   uniform_int_distribution<> random(1000, 99999);//giá
   uniform_int_distribution<> sl(3,20);//số lượng hộ
   uniform_int_distribution<> r(0,9);//đối số ngẫu nhiên cho các biến còn lại
   slho=sl(gen);
   string a="abc";
   string b="1234556789";
   for (int i=0;i<slho;i++) {
       char c=r(gen)+'0';
       ds[i].macanho={a[r(gen)%3],b[r(gen)],c,b[r(gen)]};//tạo mã căn hộ(mặc định dưới 10 tầng)
       if (i>0) {
           for (int j=0;j<i;j++) {
               while (ds[i].macanho==ds[j].macanho) {//chống lặp lại mã căn hộ
                   ds[i].macanho={a[r(gen)%3],b[r(gen)],c,b[r(gen)]};
               }
           }
       }
       ds[i].gia=random(gen)*(random(gen)/i)+200;
       ds[i].toanha=ds[i].macanho[0];
       ds[i].tang=ds[i].macanho[1]-'0';
       ds[i].dientich=i*i-(ds[i].macanho[1]-'0')+25;
       ds[i].sophongngu=ds[i].macanho[3]-'0';
       if (r(gen)>4) ds[i].trangthai="Da ban";
       else ds[i].trangthai="Chua ban";
   }
}
